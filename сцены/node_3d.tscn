[sub_resource type="GDScript" id="GDScript_emt5t"]
script/source = "extends Node3D

@export var speed: float = 15.0
@export var chunk_length: float = 10.0 # Длина одной рельсы!
@export var total_length: float = 100.0 # Общая длина ВСЕЙ очереди (кол-во рельс * длину)

func _process(delta):
	position.z += speed * delta
	
	# Если рельса улетела за спину
	if position.z > 10.0:
		# Телепортируем её на всю длину очереди назад
		position.z -= total_length
"

